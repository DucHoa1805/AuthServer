meta {
  name: 10 - Change Password Success
  type: http
  sequence: 10
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "Abcdef@123",
    "newPassword": "Xyzuvw@456",
    "confirmPassword": "Xyzuvw@456"
  }
}

script:post-response {
  test("Status 200 OK", () => {
    expect(res.getStatus()).to.equal(200);
  });

  test("Thông báo thành công + nhắc đăng nhập lại", () => {
    expect(res.body.message).to.equal("Đổi mật khẩu thành công, vui lòng đăng nhập lại");
  });
}
