meta {
  name: 04 - Login Wrong Password
  type: http
  sequence: 4
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "WrongPass@999"
  }
}

script:post-response {
  test("Status 401 Unauthorized", () => {
    expect(res.getStatus()).to.equal(401);
  });

  test("Thông báo chung, không lộ user tồn tại", () => {
    expect(res.body.error).to.equal("Username hoặc mật khẩu không chính xác");
  });
}
