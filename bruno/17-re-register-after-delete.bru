meta {
  name: 17 - Re-register After Delete
  type: http
  sequence: 17
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "email": "{{email}}",
    "password": "Abcdef@123"
  }
}

script:post-response {
  test("Status 201 - username/email được đăng ký lại sau soft delete", () => {
    expect(res.getStatus()).to.equal(201);
  });

  test("Trả về user mới với id khác user cũ", () => {
    expect(res.body.id).to.exist;
    expect(res.body.id).to.not.equal(bru.getEnvVar("userId"));
  });
}
