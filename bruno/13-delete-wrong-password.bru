meta {
  name: 13 - Delete Account Wrong Password
  type: http
  sequence: 13
}

delete {
  url: {{baseUrl}}/api/auth/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{newToken}}
}

body:json {
  {
    "password": "WrongDel@111"
  }
}

script:post-response {
  test("Status 400 BadRequest", () => {
    expect(res.getStatus()).to.equal(400);
  });

  test("Báo mật khẩu không chính xác", () => {
    expect(res.body.error).to.equal("Mật khẩu không chính xác");
  });
}
