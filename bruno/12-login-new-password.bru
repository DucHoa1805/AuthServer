meta {
  name: 12 - Login With New Password
  type: http
  sequence: 12
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "Xyzuvw@456"
  }
}

script:post-response {
  bru.setEnvVar("newToken", res.body.token);

  test("Status 200 OK", () => {
    expect(res.getStatus()).to.equal(200);
  });

  test("Có token mới", () => {
    expect(res.body.token).to.exist;
  });
}
