meta {
  name: 09 - Change Password Confirm Mismatch
  type: http
  sequence: 9
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "Abcdef@123",
    "newPassword": "Xyzuvw@456",
    "confirmPassword": "Different@789"
  }
}

script:post-response {
  test("Status 400 BadRequest khi confirm không khớp", () => {
    expect(res.getStatus()).to.equal(400);
  });
}
