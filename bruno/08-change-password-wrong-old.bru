meta {
  name: 08 - Change Password Wrong Old
  type: http
  sequence: 8
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "WrongOld@111",
    "newPassword": "Xyzuvw@456",
    "confirmPassword": "Xyzuvw@456"
  }
}

script:post-response {
  test("Status 400 BadRequest", () => {
    expect(res.getStatus()).to.equal(400);
  });

  test("Báo mật khẩu cũ không chính xác", () => {
    expect(res.body.error).to.equal("Mật khẩu cũ không chính xác");
  });
}
